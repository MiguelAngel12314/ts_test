{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "baseUrl": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "types": [
      "bootstrap",
      "jest",
      "sinon"
    ],
    "paths": {
      "@bootstrap/*": [
        "node_modules/bootstrap/*"
      ],
    }
  },
  "include": [
    "src"
  ]
}